APP_NAME=UzaPlus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uzaplus
DB_USERNAME=root
DB_PASSWORD=

# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sanctum (API / mobile app authentication)
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,127.0.0.1:8000,::1

# Reverse proxy / HTTPS
TRUSTED_PROXIES=*
FORCE_HTTPS=false
FORCE_HTTPS_IN_LOCAL=false

# Security headers (can also be configured in System Settings)
SECURITY_ENABLE_HSTS=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false
# SECURITY_CSP=
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_PERMISSIONS_POLICY="geolocation=(), microphone=(), camera=(self)"

# Beem SMS (https://beem.africa)
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=SAFCO
BEEM_SMS_URL=https://apisms.beem.africa/v1/send

# Legacy SMS aliases (optional; BEEM_* vars take precedence)
# SMS_KEY=
# SMS_TOKEN=
# SMS_SENDERID=
# SMS_URL=

# Lipisha mobile money payments
LIPISHA_ENABLED=false
LIPISHA_BUSINESS_ID=
LIPISHA_BUSINESS_NAME=
LIPISHA_BUSINESS_KEY=
LIPISHA_VERIFY_TOKEN=

# ESC/POS receipt printing (server-side: php artisan escpos:test)
ESCPOS_CONNECTOR=auto
ESCPOS_WINDOWS_PRINTER=
ESCPOS_NETWORK_HOST=
ESCPOS_NETWORK_PORT=9100
ESCPOS_LINUX_DEVICE=

# Queue job thresholds (items above this count are processed in background)
PURCHASE_INVOICE_JOB_THRESHOLD=50
SALES_INVOICE_JOB_THRESHOLD=50

# Rate limiting (defaults shown; uncomment to override)
# RATE_LIMIT_LOGIN_ATTEMPTS=5
# RATE_LIMIT_LOGIN_DECAY=15
# RATE_LIMIT_LOGIN_PER_IP_ATTEMPTS=20
# RATE_LIMIT_PASSWORD_RESET_ATTEMPTS=3
# RATE_LIMIT_PASSWORD_RESET_DECAY=15
# RATE_LIMIT_OTP_ATTEMPTS=5
# RATE_LIMIT_OTP_DECAY=5
# RATE_LIMIT_API_AUTH_ATTEMPTS=60
# RATE_LIMIT_API_AUTH_DECAY=1
# RATE_LIMIT_API_UNAUTH_ATTEMPTS=20
# RATE_LIMIT_API_UNAUTH_DECAY=1
# RATE_LIMIT_GLOBAL_ATTEMPTS=200
# RATE_LIMIT_GLOBAL_DECAY=1
# RATE_LIMIT_REGISTRATION_ATTEMPTS=3
# RATE_LIMIT_REGISTRATION_DECAY=60
# RATE_LIMIT_SEARCH_ATTEMPTS=30
# RATE_LIMIT_SEARCH_DECAY=1
# RATE_LIMIT_UPLOAD_ATTEMPTS=10
# RATE_LIMIT_UPLOAD_DECAY=1
